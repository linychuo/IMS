<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ims.system.mapper.SysMenuPermissionMapper">

    <resultMap id="BaseResultMap" type="com.ims.system.entity.SysMenuPermission">
        <id column="id" property="id"/>
        <result column="menu_id" property="menuId"/>
        <result column="permission_id" property="permissionId"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT id, menu_id, permission_id, create_time FROM sys_menu_permission
    </select>

    <delete id="deleteByMenuId">
        DELETE FROM sys_menu_permission WHERE menu_id = #{menuId}
    </delete>

    <insert id="batchInsert">
        INSERT INTO sys_menu_permission (menu_id, permission_id)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.menuId}, #{item.permissionId})
        </foreach>
    </insert>

    <select id="selectPermissionIdsByMenuId" resultType="long">
        SELECT permission_id FROM sys_menu_permission WHERE menu_id = #{menuId}
    </select>

</mapper>