<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ims.warehouse.mapper.LocationMapper">

    <resultMap id="BaseResultMap" type="com.ims.warehouse.entity.Location">
        <id column="id" property="id"/>
        <result column="location_code" property="code"/>
        <result column="location_name" property="name"/>
        <result column="warehouse_id" property="warehouseId"/>
        <result column="shelf_no" property="shelfNo"/>
        <result column="row" property="row"/>
        <result column="col" property="col"/>
        <result column="level" property="level"/>
        <result column="type" property="type"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="created_at" property="createTime"/>
        <result column="updated_at" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, location_code, location_name, warehouse_id, shelf_no, `row`, `col`, `level`, type, status, remark, created_at, updated_at
    </sql>

    <select id="selectByWarehouseId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM location WHERE warehouse_id = #{warehouseId} ORDER BY location_code ASC
    </select>

    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM location WHERE location_code = #{code} AND warehouse_id = #{warehouseId}
    </select>

</mapper>