<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ims.customer.mapper.CustomerMapper">

    <resultMap id="BaseResultMap" type="com.ims.customer.entity.Customer">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="contact" property="contact"/>
        <result column="phone" property="phone"/>
        <result column="address" property="address"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, code, name, contact, phone, address, status, remark, create_time, update_time
    </sql>

    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM customer WHERE code = #{code}
    </select>

    <select id="selectActiveList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM customer WHERE status = 1 ORDER BY name ASC
    </select>

</mapper>